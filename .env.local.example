# Copy this file to .env.local and fill in local-only secrets.
# Do not commit .env.local.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

CREDENTIAL_MASTER_KEY=replace-with-long-random-local-secret
ADMIN_API_TOKEN=replace-with-local-admin-token

STOCK_SERVER_DB_PATH=data/stock_gpt_analysis_server1.db
ENABLE_ORDER_API=0
REQUIRE_ORDER_CONFIRMATION=1
ORDER_CONFIRMATION_TEXT=주문 위험을 확인했고 실행을 승인합니다
